table DateTable
	lineageTag: bed75c8a-43a7-49a0-9f59-5b27f4ca4421

	column Date
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: 7c5035cb-6441-4b67-ad68-c79be29aaa01
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	partition DateTable = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents(DataRoot & "DateTable.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Nulls = Table.ReplaceValue(Headers,"",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),
				 Typed = Table.TransformColumnTypes(Nulls,{{"Date", type date}},"en-US")
				in Typed


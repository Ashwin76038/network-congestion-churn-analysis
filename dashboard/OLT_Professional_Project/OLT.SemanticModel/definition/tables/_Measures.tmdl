table _Measures
	lineageTag: 15a22ff8-17a7-4f12-89ae-02982ab75761

	measure 'Service Accounts' = DISTINCTCOUNT(customer_daily_metrics[customer_id])
		formatString: #,0
		lineageTag: 23b1dd29-bdb9-4b0f-8e1e-b84661263850

	measure 'Account Days' = COUNTROWS(customer_daily_metrics)
		formatString: #,0
		lineageTag: 9bdc4aef-d082-4b34-a996-c7d1026f170e

	measure 'Scenario Days' = DISTINCTCOUNT(customer_daily_metrics[log_date])
		formatString: #,0
		lineageTag: 9c105039-63f8-4274-b246-49fe38e76c63

	measure 'Experience Score' = AVERAGE(customer_daily_metrics[experience_score])
		formatString: 0.00
		lineageTag: c9437817-748e-476b-a2b0-bd58d68f98ab

	measure 'Daily Average Ratio' = AVERAGE(olt_daily_metrics[congestion_ratio])
		formatString: 0.00%
		lineageTag: 34260fb4-62e3-4549-b3d4-a59b5bc63274

	measure 'Simulated OLTs' = DISTINCTCOUNT(olt_daily_metrics[olt_id])
		formatString: #,0
		lineageTag: e4f0eafe-2994-491b-8021-2c96bdb7c34c

	measure 'Source OLT Groups' = DISTINCTCOUNT(olt_info_clean[olt_id])
		formatString: #,0
		lineageTag: c6d197c6-f146-408f-a244-468c4277f0f3

	measure 'Scored Accounts' = COALESCE(CALCULATE(DISTINCTCOUNT(customer_daily_metrics[customer_id]),FILTER(customer_daily_metrics,NOT ISBLANK(customer_daily_metrics[churn_risk_score]))),0)
		formatString: #,0
		lineageTag: d73bf113-b42f-4633-80c0-ac28af856b70

	measure 'High Risk Accounts' = IF(COUNT(customer_daily_metrics[churn_risk_score])=0,BLANK(),COALESCE(CALCULATE(DISTINCTCOUNT(customer_daily_metrics[customer_id]),KEEPFILTERS(customer_daily_metrics[churn_risk_category]="High Risk")),0))
		formatString: #,0
		lineageTag: 505e4270-9c5e-45bf-818a-cbba020c8528

	measure 'High Risk Share' = DIVIDE([High Risk Accounts],[Scored Accounts])
		formatString: 0.00%
		lineageTag: fb52c4af-d20c-4679-b2fe-41702754129b

	measure 'Risk Score' = AVERAGE(customer_daily_metrics[churn_risk_score])
		formatString: 0.00
		lineageTag: f4f774bc-d7b8-4201-84cd-72ef0facd7fd

	measure 'Complete Window Rows' = COALESCE(CALCULATE(COUNTROWS(customer_daily_metrics),KEEPFILTERS(customer_daily_metrics[usage_window_complete]=TRUE())),0)
		formatString: #,0
		lineageTag: f9d9ad2f-3e2d-4321-8069-8fd03d7f79e6

	measure 'Mismatch Accounts' = COALESCE(COUNTROWS(SUMMARIZE(FILTER(usage_logs_clean,usage_logs_clean[olt_id]<>RELATED(customers_clean[olt_id])),usage_logs_clean[customer_id])),0)
		formatString: #,0
		lineageTag: 649e1a36-38ca-4f34-8ba7-fba7934db4cf

	measure 'Mismatch Share' = DIVIDE([Mismatch Accounts],[Service Accounts])
		formatString: 0.00%
		lineageTag: d760b97a-de8b-42c2-8d32-016a262f7f1c

	measure 'Total Usage GB' = SUM(usage_logs_clean[data_usage_gb])
		formatString: #,0
		lineageTag: 7b948299-9593-4480-b9e5-598e3b28a6a1

	measure 'Average Downtime Minutes' = AVERAGE(customer_daily_metrics[downtime_minutes])
		formatString: 0.00
		lineageTag: cda0bcc2-fea3-453d-8be4-bc9754096a52

	measure 'Average Latency Ms' = AVERAGE(customer_daily_metrics[latency_ms])
		formatString: 0.00
		lineageTag: 1319f4f8-99cf-477a-9a78-eca4bd9c0a9b

	measure 'Leakage Accounts' = COALESCE(CALCULATE(DISTINCTCOUNT(customer_daily_metrics[customer_id]),KEEPFILTERS(customer_daily_metrics[complaint_leakage_flag]=1)),0)
		formatString: #,0
		lineageTag: b97f7a8e-655b-4fa7-8727-b83ffc43804c

	measure 'Synthetic Complaint Events' = COUNTROWS(complaints)
		formatString: #,0
		lineageTag: 37aca40e-a989-41cf-bcbc-50cb071d46ba

	column Value
		dataType: int64
		isHidden
		lineageTag: 583884e1-8ad4-4ba2-86fb-0a0d2d1f58bc
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source = #table(type table [Value=Int64.Type],{{1}})


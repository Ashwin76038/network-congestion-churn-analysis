table plans_clean
	lineageTag: bbee87bc-c4e9-4e36-9fb5-b622f94e233b

	column plan_id
		dataType: int64
		lineageTag: fecbb071-5f49-4e6f-a251-9c3e1fbdd855
		summarizeBy: none

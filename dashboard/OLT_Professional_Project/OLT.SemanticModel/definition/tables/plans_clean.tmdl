	column plan_tier
		dataType: string
		lineageTag: 1c3151ba-2441-4052-a1d3-b40357614f07
		summarizeBy: none
		sourceColumn: plan_tier

	column value_segment
		dataType: string
		lineageTag: 50b296b5-e79d-4aeb-abd4-b10f9cfe8b40

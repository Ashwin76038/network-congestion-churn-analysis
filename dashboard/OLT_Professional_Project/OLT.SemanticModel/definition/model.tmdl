model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["customers_clean","plans_clean","usage_logs_clean","customer_daily_metrics","olt_daily_metrics","olt_info_clean","logged_olt","complaints","DateTable","_Measures","DataRoot"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table customers_clean
ref table plans_clean
ref table usage_logs_clean
ref table customer_daily_metrics
ref table olt_daily_metrics
ref table olt_info_clean
ref table logged_olt
ref table complaints
ref table DateTable
ref table _Measures

ref cultureInfo en-US

